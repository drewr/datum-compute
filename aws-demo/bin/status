#!/usr/bin/env bash
# bin/status: fleet overview from AWS and Datum.
. "$(dirname "$0")/../lib/common.sh"
preflight
GW=$(gateway_for_net); GW=${GW:-connect-$NET-$GW_LOCATION}
printf '%-20s %-20s %-10s %s\n' NODE INSTANCE STATE SSM
for nd in $(nodes); do
  r=$(node_region "$nd"); iid=$(instance_id "$nd")
  st=$(aws ec2 describe-instances --region "$r" --instance-ids "${iid:-i-none}" --query 'Reservations[0].Instances[0].State.Name' --output text 2>/dev/null)
  p=$(aws ssm describe-instance-information --region "$r" --filters Key=InstanceIds,Values="${iid:-i-none}" --query 'InstanceInformationList[0].PingStatus' --output text 2>/dev/null)
  printf '%-20s %-20s %-10s %s\n' "$nd" "${iid:--}" "${st:--}" "${p:--}"
done
echo; dc get connectgateways "$GW" 2>&1 | head -3
echo; dc get connectnetworkbindings -o json | jq -r --arg gw "$GW" '.items[]|select(.spec.gatewayRef==$gw)|"\(.spec.connectorRef)\t\(.status.assignedAddress // "-")"'
APP=${VISUAL_NAME:-$FLEET-viewer}
h=$(dc get httpproxy "$APP" -o jsonpath='{.status.hostnames[0]}' 2>/dev/null)
echo; if [ -n "$h" ]; then echo "viewer: https://$h"; else echo "viewer: not deployed (bin/visual)"; fi
